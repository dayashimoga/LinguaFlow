{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinguaFlow",
  "version": "0.1.0",
  "identifier": "org.linguaflow.app",
  "build": {
    "beforeDevCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LinguaFlow — Multilingual Communication",
        "width": 1080,
        "height": 760,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
